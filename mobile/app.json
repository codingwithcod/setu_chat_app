{
  "expo": {
    "name": "Setu",
    "slug": "setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-branded.png",
    "scheme": "setu",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.setu.mobile"
    },
    "android": {
      "package": "app.setu.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#e84393",
        "foregroundImage": "./assets/images/android-icon-foreground-branded.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/setu-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e84393",
          "image": "./assets/images/setu-white-tr.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Setu needs access to your photos so you can send images and set your profile or group photo.",
          "cameraPermission": "Setu needs access to your camera so you can take and send photos and videos.",
          "microphonePermission": "Setu needs access to your microphone to record audio in the videos you capture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
