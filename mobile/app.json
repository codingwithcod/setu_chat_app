{
  "expo": {
    "name": "Setu",
    "slug": "setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-dark.png",
    "scheme": "setu",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.setu.mobile"
    },
    "android": {
      "package": "app.setu.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#060608",
        "foregroundImage": "./assets/images/android-icon-foreground-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/setu-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/setu-white-tr.png",
          "color": "#e84393"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Setu needs access to your photos so you can send images and set your profile or group photo.",
          "cameraPermission": "Setu needs access to your camera so you can take and send photos and videos.",
          "microphonePermission": "Setu needs access to your microphone to record audio in the videos you capture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23836ce0-0f49-48e9-8725-15b63514a99d"
      }
    }
  }
}
