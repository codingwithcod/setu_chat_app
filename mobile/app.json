{
  "expo": {
    "name": "Setu",
    "slug": "setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/setu-logo.png",
    "scheme": "setu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.setu.mobile"
    },
    "android": {
      "package": "app.setu.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#e84393",
        "foregroundImage": "./assets/images/setu-white-tr.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/setu-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e84393",
          "image": "./assets/images/setu-white-tr.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
