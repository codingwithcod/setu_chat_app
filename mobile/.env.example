# Supabase — same project as the web app. The publishable/anon key is safe to expose.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# The Next.js API URL is AUTO-DETECTED from the Metro dev-server host (port 3000).
# Only set this to override (remote/staging backend, different machine/port).
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
