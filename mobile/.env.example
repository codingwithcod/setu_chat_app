# Supabase — same project as the web app. The publishable/anon key is safe to expose.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Your Next.js API. On a physical phone (Expo Go) this MUST be your computer's
# LAN IP (e.g. http://192.168.1.14:3000), not localhost. Find it with `hostname -I`.
EXPO_PUBLIC_API_URL=http://192.168.1.14:3000
