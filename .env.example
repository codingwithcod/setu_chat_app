# ============================================
# Supabase Configuration
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Only needed for self-hosted Supabase (auto-set by setup-supabase.sh).
# Supabase Cloud uses asymmetric JWKS keys and does NOT need this.
SUPABASE_JWT_SECRET=

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Email Configuration (NodeMailer)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM="Setu Chat <noreply@setu.app>"

# ============================================
# TOTP 2FA Configuration
# ============================================
# 32-character hex key for encrypting TOTP secrets at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your-64-char-hex-key-here

# ============================================
# Chat Configuration
# ============================================
# Maximum file size for chat attachments in MB (default: 5)
NEXT_PUBLIC_MAX_CHAT_FILE_SIZE_MB=5

# ============================================
# Vercel Cron Jobs
# ============================================
# Secret used to authenticate Vercel Cron Job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be added in Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=your-cron-secret-here

# Sentry observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sentry sampling (0.0 - 1.0). 1.0 = trace every request.
# Lower in prod to control cost, e.g. 0.2.
# Server: read at runtime (change + restart, no rebuild).
SENTRY_SERVER_TRACES_SAMPLE_RATE=1.0
# Client/browser: baked at build time (change needs a rebuild).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================
# Web Push (VAPID) — background notifications
# ============================================
# Generate a keypair with: npx web-push generate-vapid-keys --json
# The PUBLIC key is exposed to the browser; the PRIVATE key is server-only.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is baked at build time (change needs a rebuild).
# VAPID_SUBJECT must be a mailto: or https: URL identifying your app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@setu.app
